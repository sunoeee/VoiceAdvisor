# Copy to backend/.env and fill in. Never commit .env or the key file.

# --- Market data vs trading ----------------------------------------------
# live = real True Markets prices (no orders). The practice portfolio, morning
#        brief, guidance and quotes all use these prices. Falls back to demo
#        prices automatically if True Markets can't be reached.
# mock = drifting demo prices.
MARKET_MODE=live
# mock   = practice balances, and confirm never sends an order (priced live, see above).
# live   = real True Markets orders. Leave this on mock until you mean to trade.
# tensho = real trades through the team's Tensho wallet server (see README).
BROKER_MODE=mock

# True Markets key. Required for MARKET_MODE=live and for BROKER_MODE=live.
TM_ENV=prod
TM_KEY_FILE=/absolute/path/to/truemarkets-api-key-XXXXXXXX.json
DO_NOT_TRACK=1

# --- Trade guardrails (enforced server-side, not by the LLM) --------------
MAX_TRADE_USD=10
DAILY_LIMIT_USD=40
ALLOWED_ASSETS=BTC,ETH,SOL
QUOTE_ASSET=USDC
QUOTE_TTL_SECONDS=30

# --- Open-source model (any OpenAI-compatible server) ---------------------
# Ollama: run `ollama pull qwen2.5:3b-instruct`. The 3B model is fast enough on a
# laptop for voice; 7B often times out the voice agent.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_SECONDS=10

# --- ElevenLabs read-aloud (morning brief) --------------------------------
# API key from elevenlabs.io/app/settings/api-keys (needs Text to Speech access).
# Backend only: never put this key in the frontend.
ELEVENLABS_API_KEY=
# Optional: any voice ID from your ElevenLabs Voices page
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Server ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
