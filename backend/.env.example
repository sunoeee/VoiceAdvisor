# Copy to backend/.env and fill in. Never commit .env or the key file.

# --- Broker ---------------------------------------------------------------
# mock = fake portfolio and prices, no money moves (default; use while building)
# live = real True Markets account
BROKER_MODE=mock

# True Markets (only needed when BROKER_MODE=live)
TM_ENV=prod
TM_KEY_FILE=/absolute/path/to/truemarkets-api-key-XXXXXXXX.json
DO_NOT_TRACK=1

# --- Trade guardrails (enforced server-side, not by the LLM) --------------
MAX_TRADE_USD=10
DAILY_LIMIT_USD=40
ALLOWED_ASSETS=BTC,ETH,SOL
QUOTE_ASSET=USDC
QUOTE_TTL_SECONDS=30

# --- Open-source model (any OpenAI-compatible server) ---------------------
# Ollama default: run `ollama pull qwen2.5:7b-instruct` then `ollama serve`
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=20

# --- Server ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
